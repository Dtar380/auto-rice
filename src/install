#!/bin/bash
# =============================================================================
#  Rice Installer
#  Usage:
#   ./install           → full install (default: run mode)
#   ./install --check   → preflight checks only, no changes
#   ./install --run     → full install (explicit)
#   ./install --resume  → resume from last successful phase
# =============================================================================

set -euo pipefail

# =============================================================================
#  CONSTANTS & GLOBAL STATE
# =============================================================================
## VERSION
readonly SCRIPT_VERSION="0.0.1"

## RUNNING
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly LOG_FILE="$SCRIPT_DIR/install-$(date +%Y%m%d-%H%M%S).log"
readonly SUDO_KEEPALIVE_PID_FILE="/tmp/rice_sudo_keepalive.pid"
readonly STATE_FILE="$SCRIPT_DIR/.install_state"
readonly PACKAGE_LIST="$SCRIPT_DIR/packages.txt"

## RICE
readonly RICE_DIR="$HOME/.local/share/rice"
readonly BACKUP_DIR="$HOME/.dotfiles_backup/$(date +%Y%m%d-%H%M%S)"

## REQUIREMENTS
readonly MIN_DISK_MB=8192

## PHASES - order matters for resume
readonly -a PHASES=(
    preflight
    base_system
    aur_helper
    gpu_drivers
    packages
    zsh
    services
    finalize
)

## INSTALLER MODE (set from CLI args)
MODE="run"

## COUNTERS FOR REPORT
FAILED_PACKAGES=()
FAILED_SERVICES=()
SKIPPED_PHASES=()

# =============================================================================
#  LOGGER
# =============================================================================
# All output goes to stdout AND the log file
exec > >(tee -i "$LOG_FILE") 2>&1

_log() {
    local level="$1"; shift
    local symbol color reset;
    reset="\e[0m"
    case "$level" in
        INFO)  symbol="[→]"; color="\e[34m";; # blue
        OK)    symbol="[✓]"; color="\e[32m";; # green
        WARN)  symbol="[!]"; color="\e[33m";; # yellow
        ERROR) symbol="[x]"; color="\e[31m";; # red
        STEP)  symbol="[▶]"; color="\e[36m";; # cyan
    esac
    echo -e "${color}${symbol} $*${reset}"
}

log_info()  { _log INFO  "$@"; }
log_ok()    { _log OK    "$@"; }
log_warn()  { _log WARN  "$@"; }
log_error() { _log ERROR "$@"; }
log_step()  { echo; _log STEP "=== $* ==="; }

# =============================================================================
#  SUDO KEEPALIVE
# =============================================================================
_start_sudo_keepalive() {
    # 1. Bail early if PID file path is not set
    if [[ -z "$SUDO_KEEPALIVE_PID_FILE" ]]; then
        log_error "SUDO_KEEPALIVE_PID_FILE is not set."
        return 1
    fi

    # 2. Fail fast if sudo auth fails
    if ! sudo -v; then
        log_error "Failed to obtain sudo credentials."
        return 1
    fi

    # 3. Kill orphaned keepalive from a previous run, if any
    if [[ -f "$SUDO_KEEPALIVE_PID_FILE" ]]; then
        local old_pid
        old_pid=$(cat "$SUDO_KEEPALIVE_PID_FILE" 2>/dev/null || true)
        [[ -n "$old_pid" ]] && kill "$old_pid" 2>/dev/null
        true
    fi

    # 4. Exit the loop if the parent process ($$) dies
    (
        while kill -0 "$$" 2>/dev/null; do
            sleep 50                              # Sleep FIRST, shorter than 60s
            sudo -n true </dev/null 2>/dev/null  # Redirect stdin/stderr to prevent prompts
        done
    ) &
    local keepalive_pid=$!
    disown "$keepalive_pid" 2>/dev/null || true

    echo $! > "$SUDO_KEEPALIVE_PID_FILE"
    log_info "Sudo keepalive started (PID: $(cat "$SUDO_KEEPALIVE_PID_FILE"))."
}

# =============================================================================
#  TRAP: ERROR + CLEANUP
# =============================================================================
_on_error() {
    local exit_code=$?
    local line_no=$1
    local command="$2"
    log_error "Script failed at line ${line_no}: '${command}' (exit code: ${exit_code})"
    log_error "Check the log for details: $LOG_FILE"
    _cleanup
    exit "$exit_code"
}

_cleanup() {
    # Stop sudo keepalive background process if running
    if [[ -f "$SUDO_KEEPALIVE_PID_FILE" ]]; then
        local kpid
        kpid=$(cat "$SUDO_KEEPALIVE_PID_FILE" 2>/dev/null || true)
        if [[ -n "$kpid" ]] && kill -0 "$kpid" 2>/dev/null; then
            kill "$kpid" 2>/dev/null || true
        fi
        rm -f "$SUDO_KEEPALIVE_PID_FILE"
    fi

    # Remove installer sudoers override
    if [[ -f /etc/sudoers.d/rice-installer ]]; then
        sudo rm -f /etc/sudoers.d/rice-installer
        log_ok "Removed installer sudoers override."
    fi
}

trap '_on_error $LINENO "$BASH_COMMAND"' ERR
trap '_cleanup' EXIT

# =============================================================================
#  PHASE CHECKPOINT SYSTEM
# =============================================================================
phase_is_done() {
    [[ -f "$STATE_FILE" ]] && grep -qx "$1" "$STATE_FILE"
}

phase_mark_done() {
    echo "$1" >> "$STATE_FILE"
    log_ok "Phase '$1' complete."
}

phase_run() {
    local phase="$1"; shift
    if [[ "$MODE" == "resume" ]] && phase_is_done "$phase"; then
        log_info "Skipping phase '$phase' (already completed)."
        SKIPPED_PHASES+=("$phase")
        return 0
    fi
    log_step "$phase"
    "$@"
    phase_mark_done "$phase"
}

# =============================================================================
#  PHASE: PREFLIGHT
# =============================================================================
do_preflight() {
    local errors=0

    # --- Check: Arch Linux only ---
    if [[ ! -f /etc/arch-release ]]; then
        log_error "This installer is for Arch Linux only. /etc/arch-release not found."
        (( errors++ ))
    else
        log_ok "Arch Linux detected."
    fi

    # --- Check: not running as root ---
    if [[[ "$EUID" -eq 0 ] || [ -n "$SUDO_USER" ]]]; then
        log_error "Do not run this script as root. RUn it as your normal user"
        (( errors++ ))
    else
        log_ok "Not running as root."
    fi

    # --- Check: sudo available and works ---
    if ! command -v sudo &>/dev/null; then
        log_error "sudo not found. Install it first: pacman -S sudo"
        (( errors++ ))
    elif ! sudo -n true 2>/dev/null && ! sudo -v; then
        log_error "Could not obtain sudo privileges."
        (( errors++ ))
    else
        log_ok "sudo is available and working."
    fi

    # --- Check: packages.txt readable with at least one package ---
    if [[ ! -f "$PACKAGE_LIST" ]]; then
        log_error "Package list not found: $PACKAGE_LIST"
        (( errors++ ))
    elif [[ ! -r "$PACKAGE_LIST" ]]; then
        log_error "Package list is not readable: $PACKAGE_LIST"
        (( errors++ ))
    else
        local pkg_count
        pkg_count=$(grep -Evc '^\s*#|^\s*$' "$PACKAGE_LIST" || true)
        if [[ "$pkg_count" -lt 1 ]]; then
            log_error "Package list '$PACKAGE_LIST' has no valid packages."
            (( errors++ ))
        else
            log_ok "Package list found with ${pkg_count} packages."
        fi
    fi

    # --- Check: internet connectivity ---
    if [ ping -c "ping.archlinux.org" > /dev/null 2>&1 ]; then
        log_error "No internet connection (archlinux.org unreachable)."
        (( errors++ ))
    else
        log_ok "Internet connection available."
    fi

    # --- Check: free disk space ---
    local free_mb
    free_mb=$(df -m / | awk 'NR==2{print $4}')
    if [[ "$free_mb" -lt "$MIN_DISK_MB" ]]; then
        log_error "Insufficient disk space: ${free_mb}MB free, need ${MIN_DISK_MB}MB."
        (( errors++ ))
    else
        log_ok "Disk space OK: ${free_mb}MB free."
    fi

    # --- Check: required tools exist ---
    local required_tools=(git lspci localectl pacman)
    for tool in "${required_tools[@]}"; do
        if ! command -v "$tool" &>/dev/null; then
            log_error "Required tool not found: $tool"
            (( errors++ ))
        fi
    done
    if [[ $errors -eq 0 ]] || [[ "${#required_tools[@]}" -gt 0 ]]; then
        log_ok "Required tools check passed."
    fi

    # --- Check: script is being run from its own directory ---
    if [[ "$SCRIPT_DIR" != "$(pwd)" ]]; then
        log_warn "Script is not being run from its own directory."
        log_warn "Expected: $SCRIPT_DIR — Got: $(pwd)"
        log_warn "Relative paths (dotfiles/, packages.txt) may not resolve correctly."
    fi

    # --- Check: Number of errors encountered ---
    if [[ "$errors" -gt 0 ]]; then
        log_error "Preflight failed with $errors error(s). Fix the issues above and re-run."
        exit 1
    fi

    log_ok "All preflight checks passed."

    # If check-only mode, exit cleanly here
    if [[ "$MODE" == "check" ]]; then
        echo
        log_ok "Check mode complete. No changes were made."
        exit 0
    fi
}

# =============================================================================
#  PHASE: BASE SYSTEM
# =============================================================================
do_base_system() {
    # Update the system
    log_info "Updating system..."
    sudo pacman -Syu --noconfirm
    log_ok "System updated."


    # Enable multilib
    if ! grep -q "^\[multilib\]" /etc/pacman.conf; then
        sudo sed -i '/\[multilib\]/{n;s/^#//}' /etc/pacman.conf
        sudo sed -i 's/^#\(\[multilib\]\)/\1/' /etc/pacman.conf
        sudo pacman -Sy --noconfirm
        log_ok "multilib enabled."
    else
        log_ok "multilib already enabled."
    fi

    # Detect kernel package (handle multiple kernels: pick the first running one)
    local KERNEL_TYPE=$(uname -r | sed -E 's/^[0-9.]+-//; s/[0-9].*//; s/-$//')
    local HEADER_PKG=""
    if [[ -n "$KERNEL_TYPE" && "$KERNEL_TYPE" != "arch" ]]; then
        HEADER_PKG="linux-${KERNEL_TYPE}-headers"
    else
        HEADER_PKG="linux-headers"
    fi

    if [[ -z "$KERNEL_TYPE" ]]; then
        log_warn "Could not detect kernel package. Skipping headers installation."
    else
        log_info "Detected kernel: $KERNEL_TYPE"
    fi

    # Install headers and basic packages
    log_info "Installing base dependencies..."
    local BASE_PACKAGES=(base-devel pciutils usbutils lshw git curl wget unzip vim rsync lua python jq)
    [[ -n "$HEADER_PKG" ]] && BASE_PACKAGES+=("$HEADER_PKG")

    sudo pacman -S --needed --noconfirm "${BASE_PACKAGES[@]}"
    log_ok "Base dependencies installed."
}

# =============================================================================
#  PHASE: AUR HELPER
# =============================================================================
do_aur_helper() {
    # --- Check: Is it already installed? ---
    if command -v paru &>/dev/null; then
        log_ok "Paru is already installed"
        return 0
    fi

    # Install paru
    log_info "Installing paru AUR helper..."
    local paru_build_dir="/tmp/paru-build-$$"
    git clone https://aur.archlinux.or/paru.git "$paru_build_dir"
    pushd "$paru_build_dir" > /dev/null
    makepkg -si --noconfirm
    popd > /dev/null
    rm -rf "$paru_build_dir"
    log_ok "paru installed."
}

# =============================================================================
#  PHASE: GPU DRIVERS
# =============================================================================
do_gpu_drivers() {
    log_info "Detecting GPU hardware..."

    mapfile -t ALL_GPUS < <(lspci -mm | grep -E '"VGA|"3D' | tr -d '"' || true)
    local GPU_COUNT=${#ALL_GPUS[@]}
    local SELECTED_GPU=""

    # --- Check: Found GPUs ---
    if [[ "$GPU_COUNT" -eq 0 ]]; then
        log_warn "No GPU hardware detected via lspci."
        read -rp "Continue with generic Mesa fallback? [y/N]: " fallback_confirm
        if [[ ! "$fallback_confirm" =~ ^[Yy]$ ]]; then
            log_error "GPU detection failed and user chose not to continue. Aborting."
            exit 1
        fi
        log_info "Installing generic Mesa fallback..."
        sudo pacman -S --needed --noconfirm mesa
        log_ok "Generic Mesa installed."
        return
    elif [[ "$GPU_COUNT" -eq 1 ]]; then
        SELECTED_GPU="${ALL_GPUS[0]}"
        log_ok "Single GPU detected."
    else
        log_info "Multiple GPUs detected:"
        echo "-------------------------------------------------------"
        for i in "${!ALL_GPUS[@]}"; do
            local gpu_name tag
            gpu_name=$(echo "${ALL_GPUS[$i]}" | cut -d' ' -f4-)
            if [[ "${ALL_GPUS[$i]}" =~ ^00:0[12]\. ]]; then
                tag="[INTEGRATED]"
            else
                tag="[DEDICATED] "
            fi
            echo "  $((i+1))) $tag $gpu_name"
        done
        echo "-------------------------------------------------------"

        # Validated input loop
        local choice
        while true; do
            read -rp "Select your primary GPU number [1-${GPU_COUNT}]: " choice
            if [[ "$choice" =~ ^[0-9]+$ ]] && \
               [[ "$choice" -ge 1 ]] && \
               [[ "$choice" -le "$GPU_COUNT" ]]; then
                break
            fi
            log_warn "Invalid selection '$choice'. Please enter a number between 1 and ${GPU_COUNT}."
        done
        SELECTED_GPU="${ALL_GPUS[$((choice-1))]}"
    fi

    # Confirm before installing
    local selected_name
    selected_name=$(echo "$SELECTED_GPU" | cut -d' ' -f4-)
    echo
    log_info "Selected GPU: $selected_name"
    read -rp "Install drivers for this GPU? [Y/n]: " gpu_confirm
    if [[ "$gpu_confirm" =~ ^[Nn]$ ]]; then
        log_warn "GPU driver installation skipped by user."
        return
    fi

    local gpu_lower
    gpu_lower=$(echo "$SELECTED_GPU" | tr '[:upper:]' '[:lower:]')

    case "$gpu_lower" in
        *nvidia*)
            log_warn "Note: nvidia-open-dkms requires Turing (RTX 20xx) or newer."
            log_warn "If you have an older card (GTX 10xx or earlier), you may need 'nvidia-dkms' instead."
            read -rp "Continue with nvidia-open-dkms? [Y/n]: " nv_confirm
            if [[ "$nv_confirm" =~ ^[Nn]$ ]]; then
                log_info "Skipping NVIDIA driver installation."
                return
            fi
            log_info "Installing NVIDIA drivers (nvidia-open-dkms)..."
            sudo pacman -S --needed --noconfirm \
                nvidia-open-dkms nvidia-utils lib32-nvidia-utils nvidia-settings egl-wayland
            log_info "Configuring NVIDIA for Wayland (modeset)..."
            echo "options nvidia_drm modeset=1 fbdev=1" | sudo tee /etc/modprobe.d/nvidia.conf >/dev/null
            sudo modprobe nvidia_drm || log_warn "Could not modprobe nvidia_drm (will take effect on next boot)."
            log_ok "NVIDIA drivers configured."
            ;;
        *amd*|*radeon*)
            log_info "Installing AMD drivers (Mesa/open source)..."
            sudo pacman -S --needed --noconfirm \
                mesa xf86-video-amdgpu libva-mesa-driver vulkan-radeon lib32-mesa lib32-vulkan-radeon
            log_ok "AMD drivers installed."
            ;;
        *intel*)
            log_info "Installing Intel drivers (Mesa/open source)..."
            sudo pacman -S --needed --noconfirm \
                mesa intel-media-driver libva-intel-driver vulkan-intel lib32-mesa
            log_ok "Intel drivers installed."
            ;;
        *)
            log_warn "Could not identify GPU vendor for: $selected_name"
            log_info "Installing generic Mesa as fallback..."
            sudo pacman -S --needed --noconfirm mesa
            log_ok "Generic Mesa installed."
            ;;
    esac
}

# =============================================================================
#  PHASE: ZSH
# =============================================================================
do_zsh_shell() {
    # Install if not installed
    if ! command -v zsh &>/dev/null; then
        sudo pacman -S zsh
    else
        log_ok "ZSH is already installed"
    fi

    # Set as default shell if not set
    local CURRENT_SHELL=$(getent passwd "$USER" | cut -d: -f7)
    local ZSH_PATH=$(which zsh)
    if [ "$CURRENT_SHELL" != "$ZSH_PATH" ]; then
        sudo cshs -s "$ZSH_PATH" "$USER"
    else
        log_ok "ZSH was already set as default shell"
    fi
}

# =============================================================================
#  PHASE: SERVICES
# =============================================================================
_unit_exists() {
    systemctl list-unit-files --full --no-legend "$1" 2>/dev/null | grep -q "$1"
}

_enable_system_service() {
    local unit="$1"
    if ! _unit_exists "$unit"; then
        log_warn "System unit '$unit' not found, skipping."
        FAILED_SERVICES+=("$unit (not found)")
        return
    fi
    if sudo systemctl enable --now "$unit"; then
        if sudo systemctl is-active --quiet "$unit"; then
            log_ok "Service '$unit' enabled and active."
        else
            log_warn "Service '$unit' enabled but not yet active (may require reboot)."
        fi
    else
        log_warn "Failed to enable service '$unit'."
        FAILED_SERVICES+=("$unit")
    fi
}

_enable_user_service() {
    local unit="$1"
    if systemctl --user enable --now "$unit" 2>/dev/null; then
        log_ok "User service '$unit' enabled."
    else
        log_warn "Failed to enable user service '$unit'. May require a graphical session or reboot."
        FAILED_SERVICES+=("user:$unit")
    fi
}

do_services() {
    log_info "Installing service packages..."
    sudo pacman -S --needed --noconfirm \
        networkmanager network-manager-applet \
        bluez bluez-utils bluetui \
        pipewire pipewire-pulse wireplumber pavucontrol
    log_ok "Service packages installed."

    log_info "Enabling services..."

    # NetworkManager
    _enable_system_service NetworkManager

    # Bluetooth — only if hardware is present
    if rfkill list bluetooth &>/dev/null || lsusb 2>/dev/null | grep -qi bluetooth || \
       lspci 2>/dev/null | grep -qi bluetooth; then
        _enable_system_service bluetooth
    else
        log_info "No Bluetooth hardware detected, skipping bluetooth service."
    fi

    # PipeWire user services
    _enable_user_service pipewire
    _enable_user_service pipewire-pulse
    _enable_user_service wireplumber

    log_ok "Service configuration complete."
}

# =============================================================================
#  PHASE: PACKAGE INSTALL
# =============================================================================
do_packages() {
    log_info "Reading package list from $PACKAGE_LIST..."

    mapfile -t PACKAGES < <(grep -Ev '^\s*#|^\s*$' "$PACKAGE_LIST" | sed 's/\s*#.*//' | tr -s ' ' '\n' | grep -v '^$')

    local total="${#PACKAGES[@]}"
    log_info "Installing $total packages..."

    for pkg in "${PACKAGES[@]}"; do
        log_info "  Installing: $pkg"
        if ! paru -S --needed --noconfirm "$pkg" 2>&1; then
            log_error "  Failed installing: $pkg"
            FAILED_PACKAGES+=("$pkg")
        else
            log_ok "  Success installing: $pkg"
        fi
    done

    if [[ "${#FAILED_PACKAGES[@]}" -gt 0 ]]; then
        log_warn "The following packages could not be installed:"
        for pkg in "${FAILED_PACKAGES[@]}"; do
            echo "    - $pkg"
        done
        log_warn "You can retry them manually with:"
        echo "    paru -S --needed ${FAILED_PACKAGES[*]}"
    else
        log_ok "All packages installed successfully."
    fi
}

# =============================================================================
#  PHASE: DOTFILES
# =============================================================================

# =============================================================================
#  PHASE: RICE SETUP
# =============================================================================

# =============================================================================
#  PHASE: HYPRLAND KEYBOARD
# =============================================================================

# =============================================================================
#  PHASE: FINALIZE
# =============================================================================
do_finalize() {
    # Create standard user directories
    if command -v xdg-user-dirs-update; then
        log_info "Creating user directories..."
        xdg-user-dirs-update
        log_ok "User directories created."
    else
        log_warn "User directories couldn't be created."
    fi

    # Safe cleanup: only remove installer temp files and yay build cache
    log_info "Cleaning up installer temp files..."
    rm -rf /tmp/yay-build-*
    yay -Sc --noconfirm 2>/dev/null || true
    # NOTE: We deliberately do NOT wipe $HOME/.cache — that would destroy
    # unrelated application state the user may want to keep.
    log_ok "Cleanup complete (user cache left intact)."

    # SDDM display manager
    if command -v sddm &>/dev/null; then
        log_info "Enabling SDDM display manager..."
        # Try both possible unit names
        if _unit_exists "sddm.service" 2>/dev/null || _unit_exists "sddm" 2>/dev/null; then
            sudo systemctl enable sddm.service 2>/dev/null || sudo systemctl enable sddm 2>/dev/null || true
            if sudo systemctl is-enabled sddm &>/dev/null || sudo systemctl is-enabled sddm.service &>/dev/null; then
                log_ok "SDDM enabled successfully. Reestart the system to apply changes."
            else
                log_warn "SDDM may not be properly enabled. Try: sudo systemctl enable sddm"
            fi
        else
            log_warn "SDDM service unit not found."
        fi
    else
        log_warn "SDDM not installed — display manager not enabled."
        log_warn "Add 'sddm' to packages.txt if you want a graphical login screen."
    fi

    log_ok "Finalization complete."
}

# =============================================================================
#  POST-INSTALL VERIFICATION REPORT
# =============================================================================
print_report() {
    echo
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  INSTALLATION REPORT"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # Phase summary
    echo
    echo "  Phases:"
    for phase in "${PHASES[@]}"; do
        if phase_is_done "$phase"; then
            echo -e "    \e[32m[✓]\e[0m $phase"
        elif [[ " ${SKIPPED_PHASES[*]} " =~ " $phase " ]]; then
            echo -e "    \e[34m[→]\e[0m $phase (skipped — already done)"
        else
            echo -e "    \e[31m[✗]\e[0m $phase (not completed)"
        fi
    done

    # Failed packages
    echo
    if [[ "${#FAILED_PACKAGES[@]}" -eq 0 ]]; then
        echo -e "  Packages:   \e[32mAll installed\e[0m"
    else
        echo -e "  Packages:   \e[31m${#FAILED_PACKAGES[@]} failed\e[0m"
        for pkg in "${FAILED_PACKAGES[@]}"; do
            echo "    - $pkg"
        done
        echo
        echo "  Retry with:"
        echo "    yay -S --needed ${FAILED_PACKAGES[*]}"
    fi

    # Failed services
    echo
    if [[ "${#FAILED_SERVICES[@]}" -eq 0 ]]; then
        echo -e "  Services:   \e[32mAll enabled\e[0m"
    else
        echo -e "  Services:   \e[33m${#FAILED_SERVICES[@]} issue(s)\e[0m"
        for svc in "${FAILED_SERVICES[@]}"; do
            echo "    - $svc"
        done
    fi

    echo
    echo "  Log file:   $LOG_FILE"
    echo "  State file: $STATE_FILE"
    if [[ -d "$BACKUP_DIR" ]]; then
        echo "  Backups:    $BACKUP_DIR"
    fi
    echo "  Rice dir:   $RICE_DIR"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo
    log_ok "Installation complete! Please reboot your system."

    read -rp "  Reboot now? [y/N]: " reboot_now
    if [[ "$reboot_now" =~ ^[Yy]$ ]]; then
        _cleanup
        sudo reboot
    fi
}

# =============================================================================
#  ARGUMENT PARSING
# =============================================================================
case "${1:-}" in
    --check)  MODE="check" ;;
    --run)    MODE="run" ;;
    --resume) MODE="resume" ;;
    "")       MODE="run" ;;
    *)
        echo "Usage: $0 [--check | --run | --resume]"
        echo "  --check   Preflight checks only, no changes"
        echo "  --run     Full install (default)"
        echo "  --resume  Resume from last successful phase"
        exit 1
        ;;
esac

# =============================================================================
#  MAIN
# =============================================================================
echo
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Rice Installer v${SCRIPT_VERSION} — mode: ${MODE^^}"
echo "  Log: $LOG_FILE"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if [[ "$MODE" == "resume" ]] && [[ ! -f "$STATE_FILE" ]]; then
    log_warn "No state file found at $STATE_FILE. Starting fresh."
    MODE="run"
fi

# Preflight always runs (it doesn't write state itself in check mode)
do_preflight

# Start sudo keepalive for install/resume modes
_start_sudo_keepalive

phase_run preflight          true   # already done above — mark it
phase_run base_system        do_base_system
phase_run aur_helper         do_aur_helper
phase_run gpu_drivers        do_gpu_drivers
phase_run zsh                do_zsh
phase_run services           do_services
phase_run packages           do_packages
phase_run finalize           do_finalize

print_report
