#!/bin/bash
# =============================================================================
#  Rice Installer
#  Usage:
#   ./install           → full install (default: run mode)
#   ./install --check   → preflight checks only, no changes
#   ./install --run     → full install (explicit)
#   ./install --resume  → resume from last successful phase
# =============================================================================

set -euo pipefail

# =============================================================================
#  CONSTANTS & GLOBAL STATE
# =============================================================================
## VERSION
readonly SCRIPT_VERSION="0.0.1"

## RUNNING
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly LOG_FILE="$SCRIPT_DIR/install-$(date +%Y%m%d-%H%M%S).log"
readonly SUDO_KEEPALIVE_PID_FILE="/tmp/rice_sudo_keepalive.pid"
readonly STATE_FILE="$SCRIPT_DIR/.install_state"
readonly PACKAGE_LIST="$SCRIPT_DIR/packages.txt"

## RICE
readonly RICE_DIR="$HOME/.local/share/rice"
readonly BACKUP_DIR="$HOME/.dotfiles_backup/$(date +%Y%m%d-%H%M%S)"

## REQUIREMENTS
readonly MIN_DISK_MB=8192

## PHASES - order matters for resume
readonly -a PHASES=(

)

## INSTALLER MODE (set from CLI args)
MODE="run"

## COUNTERS FOR REPORT
FAILED_PACKAGES=()
FAILED_SERVICES=()
SKIPPED_PHASES=()

# =============================================================================
#  LOGGER
# =============================================================================
# All output goes to stdout AND the log file
exec > >(tee -i "$LOG_FILE") 2>&1

_log() {
    local level="$1"; shift
    local symbol color reset;
    reset="\e[0m"
    case "$level" in
        INFO)  symbol="[→]"; color="\e[34m";; # blue
        OK)    symbol="[✓]"; color="\e[32m";; # green
        WARN)  symbol="[!]"; color="\e[33m";; # yellow
        ERROR) symbol="[x]"; color="\e[31m";; # red
        STEP)  symbol="[▶]"; color="\e[36m";; # cyan
    esac
    echo -e "${color}${symbol} $*${reset}"
}

log_info()  { _log INFO  "$@"; }
log_ok()    { _log OK    "$@"; }
log_warn()  { _log WARN  "$@"; }
log_error() { _log ERROR "$@"; }
log_step()  { echo; _log STEP "=== $* ==="; }

# =============================================================================
#  SUDO KEEPALIVE
# =============================================================================
_start_sudo_keepalive() {
    # 1. Bail early if PID file path is not set
    if [[ -z "$SUDO_KEEPALIVE_PID_FILE" ]]; then
        log_error "SUDO_KEEPALIVE_PID_FILE is not set."
        return 1
    fi

    # 2. Fail fast if sudo auth fails
    if ! sudo -v; then
        log_error "Failed to obtain sudo credentials."
        return 1
    fi

    # 3. Kill orphaned keepalive from a previous run, if any
    if [[ -f "$SUDO_KEEPALIVE_PID_FILE" ]]; then
        local old_pid
        old_pid=$(cat "$SUDO_KEEPALIVE_PID_FILE" 2>/dev/null || true)
        [[ -n "$old_pid" ]] && kill "$old_pid" 2>/dev/null
        true
    fi

    # 4. Exit the loop if the parent process ($$) dies
    (
        while kill -0 "$$" 2>/dev/null; do
            sleep 50                              # Sleep FIRST, shorter than 60s
            sudo -n true </dev/null 2>/dev/null  # Redirect stdin/stderr to prevent prompts
        done
    ) &
    local keepalive_pid=$!
    disown "$keepalive_pid" 2>/dev/null || true

    echo $! > "$SUDO_KEEPALIVE_PID_FILE"
    log_info "Sudo keepalive started (PID: $(cat "$SUDO_KEEPALIVE_PID_FILE"))."
}

# =============================================================================
#  TRAP: ERROR + CLEANUP
# =============================================================================
_on_error() {
    local exit_code=$?
    local line_no=$1
    local command="$2"
    log_error "Script failed at line ${line_no}: '${command}' (exit code: ${exit_code})"
    log_error "Check the log for details: $LOG_FILE"
    _cleanup
    exit "$exit_code"
}

_cleanup() {
    # Stop sudo keepalive background process if running
    if [[ -f "$SUDO_KEEPALIVE_PID_FILE" ]]; then
        local kpid
        kpid=$(cat "$SUDO_KEEPALIVE_PID_FILE" 2>/dev/null || true)
        if [[ -n "$kpid" ]] && kill -0 "$kpid" 2>/dev/null; then
            kill "$kpid" 2>/dev/null || true
        fi
        rm -f "$SUDO_KEEPALIVE_PID_FILE"
    fi

    # Remove installer sudoers override
    if [[ -f /etc/sudoers.d/rice-installer ]]; then
        sudo rm -f /etc/sudoers.d/rice-installer
        log_ok "Removed installer sudoers override."
    fi
}

trap '_on_error $LINENO "$BASH_COMMAND"' ERR
trap '_cleanup' EXIT

# =============================================================================
#  PHASE CHECKPOINT SYSTEM
# =============================================================================
phase_is_done() {
    [[ -f "$STATE_FILE" ]] && grep -qx "$1" "$STATE_FILE"
}

phase_mark_done() {
    echo "$1" >> "$STATE_FILE"
    log_ok "Phase '$1' complete."
}

phase_run() {
    local phase="$1"; shift
    if [[ "$MODE" == "resume" ]] && phase_is_done "$phase"; then
        log_info "Skipping phase '$phase' (already completed)."
        SKIPPED_PHASES+=("$phase")
        return 0
    fi
    log_step "$phase"
    "$@"
    phase_mark_done "$phase"
}

# =============================================================================
#  PHASE: PREFLIGHT
# =============================================================================
preflight() {
    local errors=0

    # --- Check: Arch Linux only ---
    if [[ ! -f /etc/arch-release ]]; then
        log_error "This installer is for Arch Linux only. /etc/arch-release not found."
        (( errors++ ))
    else
        log_ok "Arch Linux detected."
    fi

    # --- Check: not running as root ---
    if [[[ "$EUID" -eq 0 ] || [ -n "$SUDO_USER" ]]]; then
        log_error "Do not run this script as root. RUn it as your normal user"
        (( errors++ ))
    else
        log_ok "Not running as root."
    fi

    # --- Check: sudo available and works ---
    if ! command -v sudo &>/dev/null; then
        log_error "sudo not found. Install it first: pacman -S sudo"
        (( errors++ ))
    elif ! sudo -n true 2>/dev/null && ! sudo -v; then
        log_error "Could not obtain sudo privileges."
        (( errors++ ))
    else
        log_ok "sudo is available and working."
    fi

    # --- Check: packages.txt readable with at least one package ---
    if [[ ! -f "$PACKAGE_LIST" ]]; then
        log_error "Package list not found: $PACKAGE_LIST"
        (( errors++ ))
    elif [[ ! -r "$PACKAGE_LIST" ]]; then
        log_error "Package list is not readable: $PACKAGE_LIST"
        (( errors++ ))
    else
        local pkg_count
        pkg_count=$(grep -Evc '^\s*#|^\s*$' "$PACKAGE_LIST" || true)
        if [[ "$pkg_count" -lt 1 ]]; then
            log_error "Package list '$PACKAGE_LIST' has no valid packages."
            (( errors++ ))
        else
            log_ok "Package list found with ${pkg_count} packages."
        fi
    fi

    # --- Check: internet connectivity ---
    if [ ping -c "ping.archlinux.org" > /dev/null 2>&1 ]; then
        log_error "No internet connection (archlinux.org unreachable)."
        (( errors++ ))
    else
        log_ok "Internet connection available."
    fi

    # --- Check: free disk space ---
    local free_mb
    free_mb=$(df -m / | awk 'NR==2{print $4}')
    if [[ "$free_mb" -lt "$MIN_DISK_MB" ]]; then
        log_error "Insufficient disk space: ${free_mb}MB free, need ${MIN_DISK_MB}MB."
        (( errors++ ))
    else
        log_ok "Disk space OK: ${free_mb}MB free."
    fi

    # --- Check: required tools exist ---
    local required_tools=(git lspci localectl pacman)
    for tool in "${required_tools[@]}"; do
        if ! command -v "$tool" &>/dev/null; then
            log_error "Required tool not found: $tool"
            (( errors++ ))
        fi
    done
    if [[ $errors -eq 0 ]] || [[ "${#required_tools[@]}" -gt 0 ]]; then
        log_ok "Required tools check passed."
    fi

    # --- Check: script is being run from its own directory ---
    if [[ "$SCRIPT_DIR" != "$(pwd)" ]]; then
        log_warn "Script is not being run from its own directory."
        log_warn "Expected: $SCRIPT_DIR — Got: $(pwd)"
        log_warn "Relative paths (dotfiles/, packages.txt) may not resolve correctly."
    fi

    # --- Check: Number of errors encountered ---
    if [[ "$errors" -gt 0 ]]; then
        log_error "Preflight failed with $errors error(s). Fix the issues above and re-run."
        exit 1
    fi

    log_ok "All preflight checks passed."

    # If check-only mode, exit cleanly here
    if [[ "$MODE" == "check" ]]; then
        echo
        log_ok "Check mode complete. No changes were made."
        exit 0
    fi
}

# =============================================================================
#  PHASE: BASE SYSTEM
# =============================================================================
base_system() {
    # Update the system
    log_info "Updating system..."
    sudo pacman -Syu --noconfirm
    log_ok "System updated."


    # Enable multilib
    if ! grep -q "^\[multilib\]" /etc/pacman.conf; then
        sudo sed -i '/\[multilib\]/{n;s/^#//}' /etc/pacman.conf
        sudo sed -i 's/^#\(\[multilib\]\)/\1/' /etc/pacman.conf
        sudo pacman -Sy --noconfirm
        log_ok "multilib enabled."
    else
        log_ok "multilib already enabled."
    fi

    # Detect kernel package (handle multiple kernels: pick the first running one)
    local KERNEL_TYPE=$(uname -r | sed -E 's/^[0-9.]+-//; s/[0-9].*//; s/-$//')
    local HEADER_PKG=""
    if [[ -n "$KERNEL_TYPE" && "$KERNEL_TYPE" != "arch" ]]; then
        HEADER_PKG="linux-${KERNEL_TYPE}-headers"
    else
        HEADER_PKG="linux-headers"
    fi

    if [[ -z "$KERNEL_TYPE" ]]; then
        log_warn "Could not detect kernel package. Skipping headers installation."
    else
        log_info "Detected kernel: $KERNEL_TYPE"
    fi

    # Install headers and basic packages
    log_info "Installing base dependencies..."
    local BASE_PACKAGES=(base-devel pciutils usbutils lshw git curl wget unzip vim rsync lua python jq)
    [[ -n "$HEADER_PKG" ]] && BASE_PACKAGES+=("$HEADER_PKG")

    sudo pacman -S --needed --noconfirm "${BASE_PACKAGES[@]}"
    log_ok "Base dependencies installed."
}

# =============================================================================
#  PHASE: AUR HELPER
# =============================================================================
aur_helper() {
    # --- Check: Is it already installed? ---
    if command -v paru &>/dev/null; then
        log_ok "Paru is already installed"
        return 0
    fi

    # Install paru
    git clone https://aur.archlinux.or/paru.git /tmp/paru
    pushd /tmp/paru > /dev/null
    makepkg -si --noconfirm
    popd > /dev/null
    rm -rf /tmp/paru
}

# =============================================================================
#  PHASE: SERVICES
# =============================================================================

# =============================================================================
#  PHASE: ZSH
# =============================================================================
zsh_shell() {
    # Install if not installed
    if ! command -v zsh &>/dev/null; then
        sudo pacman -S zsh
    else
        log_ok "ZSH is already installed"
    fi

    # Set as default shell if not set
    local CURRENT_SHELL=$(getent passwd "$USER" | cut -d: -f7)
    local ZSH_PATH=$(which zsh)
    if [ "$CURRENT_SHELL" != "$ZSH_PATH" ]; then
        sudo cshs -s "$ZSH_PATH" "$USER"
    else
        log_ok "ZSH was already set as default shell"
    fi
}

